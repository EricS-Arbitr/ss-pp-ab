# Elastic Defend custom event filters — rendered by so_manager, do not hand-edit.
#
# WHY THIS FILE EXISTS
# --------------------
# pp-splunk generated 11,147,502 endpoint.events.file records in 24 hours --
# 96% of all its telemetry, a flat ~480k/hour. That is Splunk writing index
# buckets, journal slices and tsidx files; a database journaling to disk, one
# event at a time. It has no detection value and it dominates Elasticsearch
# retention, ageing out the corp-workstation data actually worth hunting on.
#
# HOW IT IS DELIVERED
# -------------------
# so-elastic-defend-manage-filters.py reads
#   /opt/so/conf/elastic-fleet/defend-exclusions/rulesets/custom-filters-raw
# and converts it into the custom-filters/ directory it then uploads. That raw
# file is salt-managed (`file.managed` from
# salt://elasticfleet/files/soc/elastic-defend-custom-filters.yaml), so writing
# it directly is reverted by the next highstate -- the soc.json trap. We
# override the SOURCE in local/salt instead, which takes precedence in
# file_roots. Same technique as the GRE iptables.jinja override.
#
# The stock file contains only non-functional templates whose `id` fields read
# "This needs to be a UUIDv4 id", so replacing it wholesale loses nothing.
#
# FIELD SEMANTICS (read from so-elastic-defend-manage-filters.py, not guessed)
#   TargetFilename -> file.path        (generic ECS: works on Linux, despite
#                                       every filter SO ships being Windows)
#   file_create / file_delete -> endpoint.events.file
#   'begin with' -> ("included", "wildcard")
#   operating_system is NOT read by the script. Filters are grid-wide, which is
#   safe here only because these paths exist on one host.
#
# QUOTING: every interpolated value is passed through replace("'", "''").
# YAML single-quoted scalars escape a quote by doubling it, and an unescaped
# apostrophe silently truncates the value -- "96% of that host's telemetry"
# broke the parse during local render testing before this shipped.
{% for f in so_defend_exclusions %}
{% if not loop.first %}---
{% endif %}
title: '{{ f.title | replace("'", "''") }}'
id: '{{ f.id | replace("'", "''") }}'
description: '{{ f.description | trim | replace("'", "''") }}'
references: '{{ (f.references | default('Arbitr - PowerPlant range tuning')) | replace("'", "''") }}'
author: 'Arbitr'
date: '{{ f.date | replace("'", "''") }}'
event_type: '{{ f.event_type | replace("'", "''") }}'
filter_type: 'exclude'
filter:
  selection_1:
    TargetField: '{{ f.target_field | replace("'", "''") }}'
    Condition: '{{ f.condition | replace("'", "''") }}'
    Pattern: '{{ f.pattern | replace("'", "''") }}'
operating_system: '{{ (f.operating_system | default('linux')) | replace("'", "''") }}'
{% endfor %}
