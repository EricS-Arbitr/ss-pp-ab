{% if 'domain_controllers' in group_names and (dns_debug_logging | default(false) | bool) %}
###### DNS Server query logging — domain controllers only ######
# MonitorNoHandle, not monitor: the DNS service holds dns.log open exclusively
# and an ordinary file monitor cannot read it. This is the input type
# Splunk_TA_windows itself ships for this file, and MSAD:NT6:DNS is the
# sourcetype its props.conf parses.
#
# Scoped to DCs deliberately -- the other 45 Windows hosts have no DNS server
# and would monitor a path that never exists, which reports no error anywhere.
[MonitorNoHandle://{{ dns_debug_log_path }}]
disabled = 0
index = windows
sourcetype = MSAD:NT6:DNS
{% endif %}
