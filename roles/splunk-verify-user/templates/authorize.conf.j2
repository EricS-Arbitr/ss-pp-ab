### Managed by Ansible — roles/splunk-verify-user. Do not edit on the host.
#
# Least-privilege role for verify_deployment.sh. Inherits `user` (search, plus
# read on globally-shared knowledge objects such as the CIM data models), adds
# only the REST reads needed to assert which add-ons are installed, and grants
# no write, no delete, no admin.
#
# srchIndexesAllowed = * is deliberate: the verifier has to see every index the
# range writes to, or a missing index reads as a passing check.
#
# 2026-08-18. svc_verify sees ~85 of 454,659 Sysmon events. Ruled out BY
# MEASUREMENT, not by reasoning -- each of these was a hypothesis I shipped
# before checking, and each was wrong:
#
#   index permissions   `| rest /services/authorization/roles/arbitr_verify`
#                       shows srchIndexesAllowed = * AND
#                       imported_srchIndexesAllowed = *. All 454,659 events
#                       live in ONE index (sysmon), which the account reads.
#   srchFilter          BOTH srchFilter and imported_srchFilter are EMPTY.
#                       There is no search filter to widen. The `srchFilter = *`
#                       briefly added here was removed -- it fixed nothing and
#                       carrying a workaround for a non-existent problem is the
#                       same mistake as overlaying config for the sourcetype
#                       rename.
#   srchTimeWin         the role inherits -1 (unlimited) from `user`, and the
#                       account already saw only 74 events BEFORE any value was
#                       set here. Setting 0 was doubly wrong: it did not help,
#                       and 0 is MORE restrictive than the -1 it overrode.
#                       Corrected to -1.
#
# What has NOT been controlled for: every svc_verify measurement was taken
# through `splunk search` on the CLI, and every admin measurement through
# Splunk Web. That comparison varies the account AND the interface at once, so
# it cannot attribute the difference to either. Run the identical CLI search as
# admin before treating this as an authorization problem at all.

[role_{{ splunk_verify_role }}]
importRoles = user
search = enabled
srchIndexesAllowed = *
srchIndexesDefault = *
srchTimeWin = -1
srchJobsQuota = 5
rtSrchJobsQuota = 0
srchDiskQuota = 500
{% for cap in splunk_verify_capabilities %}
{{ cap }} = enabled
{% endfor %}
